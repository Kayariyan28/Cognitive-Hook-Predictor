# Required: full immutable Hugging Face model commit SHA. Mutable refs are rejected.
TRIBE_MODEL_REVISION=f894e783020944dcd96e5568550afe2aa9743f9f

# Optional launcher override. Prefer a physical Python 3.11 environment outside
# iCloud/File Provider when the checkout is under a synced Documents folder.
# SIGNALFRAME_BACKEND_PYTHON=/srv/signalframe/py311/bin/python

TRIBE_MODEL_ID=facebook/tribev2
TRIBE_CHECKPOINT_NAME=best.ckpt
TRIBE_DEVICE=cuda
TRIBE_INFERENCE_MODE=full
# V-JEPA2 execution policy. autocast-fp16 is accepted only with mps.
TRIBE_VIDEO_DEVICE=cuda
TRIBE_VIDEO_PRECISION=fp32
TRIBE_PRELOAD_MODEL=true

# A read token whose account has accepted the gated Llama 3.2-3B terms.
HF_TOKEN=

TRIBE_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
TRIBE_CORS_ALLOW_CREDENTIALS=false
TRIBE_MAX_UPLOAD_BYTES=536870912

# Optional persistent paths. Defaults live under backend/.runtime/.
# TRIBE_CACHE_DIR=/srv/tribe/cache
# TRIBE_HUB_CACHE_DIR=/srv/huggingface/hub
# TRIBE_RESULT_DIR=/srv/tribe/results
# TRIBE_WORK_DIR=/srv/tribe/work

# Optional, read-only creator forecast capability registry. Set at most one.
# Entries fail closed unless immutable revisions and real local artifact hashes match.
# FORECAST_REGISTRY_PATH=/srv/forecast/creator-forecast-registry.json
# FORECAST_REGISTRY_JSON={"schemaVersion":"creator-forecast-registry/1","branches":{},"heads":{}}

# Optional NanoLLaVA still-keyframe fallback. Keep MLX-VLM in its own venv;
# both paths must already exist and the snapshot weights must match the pin.
# FORECAST_NANOLLAVA_PYTHON=/srv/forecast/venvs/mlx-vlm-0.6.8/bin/python
# FORECAST_NANOLLAVA_SNAPSHOT=/srv/huggingface/hub/models--mlx-community--nanoLLaVA-1.5-8bit/snapshots/6e2bc13b87ab178668313552b9d69026af7d556f
# FORECAST_NANOLLAVA_TIMEOUT_SECONDS=300
