# SignalFrame backend profile for Apple silicon.
# Copy to backend/.env.local, then adjust only paths for optional model workers.

# Default location used by docs/MACOS_SETUP.md. This value is evaluated when
# backend/run-local-mac.sh sources the file, so the quoted path may contain spaces.
SIGNALFRAME_BACKEND_PYTHON="$HOME/Library/Application Support/SignalFrame/py311/bin/python"

# Pinned official TRIBE v2 model identity.
TRIBE_MODEL_ID=facebook/tribev2
TRIBE_MODEL_REVISION=f894e783020944dcd96e5568550afe2aa9743f9f
TRIBE_CHECKPOINT_NAME=best.ckpt

# Genuine vision-only TRIBE inference on Apple silicon. This is an official
# modality ablation, not the published full video+audio+text pipeline.
TRIBE_DEVICE=mps
TRIBE_INFERENCE_MODE=vision-only
TRIBE_VIDEO_DEVICE=mps
TRIBE_VIDEO_PRECISION=autocast-fp16
TRIBE_PRELOAD_MODEL=false

TRIBE_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
TRIBE_CORS_ALLOW_CREDENTIALS=false
TRIBE_MAX_UPLOAD_BYTES=536870912

# Keep these caches outside iCloud/File Provider when possible. Uncomment and
# replace the example paths with absolute paths owned by your account.
# TRIBE_CACHE_DIR=/absolute/path/to/signalframe/cache
# TRIBE_HUB_CACHE_DIR=/absolute/path/to/huggingface/hub
# TRIBE_RESULT_DIR=/absolute/path/to/signalframe/results
# TRIBE_WORK_DIR=/absolute/path/to/signalframe/work

# Optional V-JEPA 2.1 evidence worker. CPU/fp32 is the verified accuracy-first
# Mac profile. The three artifact variables must be configured together.
# FORECAST_VJEPA21_SOURCE_PATH=/absolute/path/to/pinned/vjepa2/source
# FORECAST_VJEPA21_CHECKPOINT_PATH=/absolute/path/to/vjepa2_1_vitb_dist_vitG_384.pt
# FORECAST_VJEPA21_CHECKPOINT_SHA256=34d5d0ae6f1297511b9d669890350d059dd3ff7b75df23eb845f2aa14e610220
FORECAST_VJEPA21_DEVICE=cpu

# Optional NanoLLaVA still-keyframe semantics worker. Use a dedicated MLX-VLM
# environment and a fully downloaded, pinned local model snapshot.
# FORECAST_NANOLLAVA_PYTHON=/absolute/path/to/mlx-vlm-0.6.8/bin/python
# FORECAST_NANOLLAVA_SNAPSHOT=/absolute/path/to/nanollava/snapshot
# FORECAST_NANOLLAVA_TIMEOUT_SECONDS=300

# Optional local AST audio model snapshot.
# FORECAST_AST_SNAPSHOT=/absolute/path/to/ast/snapshot

# Forecast jobs are asynchronous and remain strictly score-gated unless a
# code-approved, production-calibrated behavioral head is installed.
FORECAST_MAX_WORKERS=1
FORECAST_MAX_ACTIVE_JOBS=4
FORECAST_JOB_TIMEOUT_SECONDS=1800
