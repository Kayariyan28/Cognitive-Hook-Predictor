# SignalFrame on a CUDA host (Colab, or any Linux box with an NVIDIA GPU).
#
# Copy to backend/.env.local and edit. The Mac profile lives in
# backend/.env.macos.example; this one selects the portable torch backends
# instead of the MLX ones. Nothing here changes what the lanes are allowed to
# claim — only which runtime computes them.
#
# Every model lane stays unavailable until its revision is pinned to a full
# 40-character commit SHA. That is deliberate: a mutable name like "main" would
# make a result impossible to reproduce, so it is refused rather than accepted.

# ---------------------------------------------------------------- device ----
# auto | cuda | mps | cpu. `auto` prefers cuda, then mps, then cpu, and records
# which it picked in the manifest. Naming a device that is not present is
# refused rather than quietly run somewhere else.
SIGNALFRAME_TORCH_DEVICE=auto
# auto | float32 | float16 | bfloat16. `auto` is float16 on GPU, float32 on CPU.
SIGNALFRAME_TORCH_DTYPE=auto

# --------------------------------------------------------------- insight ----
# torch-local runs the model on this machine; anthropic sends only derived JSON
# evidence, and only with INSIGHT_CLOUD_ENABLED=true and a key present.
INSIGHT_PROVIDER=torch-local
INSIGHT_CLOUD_ENABLED=false
# ANTHROPIC_API_KEY=
INSIGHT_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

INSIGHT_LOCAL_MODEL=Qwen/Qwen2.5-7B-Instruct
# INSIGHT_LOCAL_MODEL_REVISION=

INSIGHT_MAX_OUTPUT_TOKENS=1536
INSIGHT_TIMEOUT_SECONDS=120

# ------------------------------------------------------------- transcript ----
INSIGHT_ASR_BACKEND=transformers
INSIGHT_ASR_MODEL=openai/whisper-large-v3-turbo
# INSIGHT_ASR_MODEL_REVISION=

# --------------------------------------------------------- on-screen text ----
# Apple Vision is macOS-only; tesseract is the engine everywhere else and also
# needs the `tesseract` binary on PATH.
INSIGHT_OCR_ENGINE=pytesseract

# ------------------------------------------------------------- keyframes ----
# The portable NanoLLaVA weights are a different repository from the MLX ones,
# and they ship an auto_map — loading them runs model code from the pinned
# snapshot. That is off unless you turn it on deliberately.
FORECAST_NANOLLAVA_BACKEND=transformers
FORECAST_NANOLLAVA_TORCH_MODEL=qnguyen3/nanoLLaVA-1.5
# FORECAST_NANOLLAVA_TORCH_REVISION=
FORECAST_NANOLLAVA_TRUST_REMOTE_CODE=false
FORECAST_NANOLLAVA_HOOK_PASS=true

# ------------------------------------------------------------- comparative ----
# A Colab session accumulates few clips; lower this if you want the comparative
# view before you have twenty.
INSIGHT_COMPARATIVE_MINIMUM_CLIPS=20
INSIGHT_COMPARATIVE_WINDOW=50

# ---------------------------------------------------------------- cortical ----
# TRIBE v2 needs accepted gated terms and a token. Colab is the better host for
# this lane than macOS: CUDA runs the full trimodal path rather than the
# vision-only ablation. The weights are CC BY-NC 4.0 — non-commercial.
# HF_TOKEN=
# TRIBE_MODEL_ID=facebook/tribev2
# TRIBE_MODEL_REVISION=
# TRIBE_DEVICE=cuda
# TRIBE_VIDEO_DEVICE=cuda
# TRIBE_VIDEO_PRECISION=fp32
# TRIBE_INFERENCE_MODE=full
